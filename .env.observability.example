# 仅限本地演示。复制为 .env.observability 后，先更换为独立随机凭证。
# 可在 WSL 用 `openssl rand -base64 32` 生成本地随机密码；
# 将结果写入未跟踪的 .env.observability，不要发到聊天或提交仓库。
# 不要复用星辙、Airwallex、数据库或任何生产账户的密码。
OBS_GRAFANA_ADMIN_USER=local-operator
OBS_GRAFANA_ADMIN_PASSWORD=change-me-local-only

# 所有宿主端口仅绑定 127.0.0.1；如本机冲突，可改为其他空闲端口。
OBS_GRAFANA_HOST_PORT=3300
OBS_PROMETHEUS_HOST_PORT=9091
OBS_OTLP_HTTP_HOST_PORT=4318

# 仅本地 IDEA 进程的开发示例。将这些行合并到项目根目录 .env，
# 不要把它们加到生产配置；生产需使用内部可达地址和经审核的采样策略。
MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=true
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://localhost:4318/v1/traces
MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_TRANSPORT=http
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
# 本地支付状态记录未变化的观察阈值；服务商状态变化也会更新时间，仅用于监控，不代表支付失败或业务超时。
DIAGNOSTICS_TELEMETRY_STALE_PENDING_MINUTES=15
# 若修改 OBS_OTLP_HTTP_HOST_PORT，必须把上述 OTLP endpoint 的端口改为相同值。
# Compose 与 IDEA 是独立进程，端口变量不会自动同步；默认均为 4318。

# 自托管演示留存窗口，可根据星辙环境的数据保留策略调整。
OBS_PROMETHEUS_RETENTION=15d
OBS_LOKI_RETENTION=168h
