{
  "name": "startrail-payment",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "dev:backend": "./backend/mvnw -f backend/pom.xml spring-boot:run -Dspring-boot.run.profiles=local",
    "dev:web": "pnpm --filter frontend dev",
    "build:web": "pnpm --filter frontend build",
    "lint:web": "pnpm --filter frontend lint"
  }
}
