# Airwallex 沙盒凭据。仅服务端读取，不要提交真实值。
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=

# 本地 PostgreSQL 连接；与 compose.yaml 默认值一致。
DB_URL=jdbc:postgresql://localhost:5433/startrail_payment
DB_USERNAME=startrail
DB_PASSWORD=startrail_local

# 本地模拟星辙双向签名密钥。两个方向可不同；正式环境在部署平台另行注入正式凭据。
STARTRAIL_LOCAL_INBOUND_SECRET=local-only-change-me
STARTRAIL_LOCAL_REFUND_INBOUND_SECRET=local-only-refund-change-me
STARTRAIL_LOCAL_OUTBOUND_SECRET=local-only-change-me

# 本地付款入口与星辙订单返回页；生产必须在部署环境设置为可信 HTTPS 地址。
PAYMENT_CHECKOUT_PUBLIC_BASE_URL=http://localhost:5173
STARTRAIL_BUSINESS_ORDER_URL_TEMPLATE=http://localhost:5175/mock-xingzhe/order/{businessOrderId}

# 运营后台首次启动账号。密码至少 16 位；只在首次创建时写入摘要，之后不覆盖。
OPERATOR_OWNER_USERNAME=owner
OPERATOR_OWNER_PASSWORD=
OPERATOR_STAFF_USERNAME=xingzhe-admin
OPERATOR_STAFF_PASSWORD=
